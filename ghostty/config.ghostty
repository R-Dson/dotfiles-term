font-family = "AporeticSansMonoNerdFont"
font-size = 11

font-style = "Light"
font-style-bold = "Regular"
font-style-bold-italic = "Italic"
font-synthetic-style = ""
bold-is-bright = true
adjust-cell-height = 5%

background = #282a36
foreground = #f8f8f2
cursor-color = #f8f8f2

palette = 0=#44475a
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#f8f8f2

palette = 8=#6272a4
palette = 9=#ff5555
palette = 10=#50fa7b
palette = 11=#f1fa8c
palette = 12=#bd93f9
palette = 13=#ff79c6
palette = 14=#8be9fd
palette = 15=#f8f8f2

command = "$(which fish)"

window-decoration = false 
#gtk-titlebar-style = tabs
