# --- Font & Size ---
font-family = "Aporetic Sans Mono"
font-size = 11

font-style = "Light"
font-style-bold = "Regular"
font-style-bold-italic = "Italic"
font-synthetic-style = ""
bold-is-bright = true
adjust-cell-height = 5%

background = #282a36
foreground = #f8f8f2
cursor-color = #f8f8f2

palette = 0=#bd93f9
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#ff79c6
palette = 4=#8be9fd
palette = 5=#f1fa8c
palette = 6=#6272a4
palette = 7=#44475a

palette = 8=#bd93f9
palette = 9=#ff5555
palette = 10=#50fa7b
palette = 11=#ff79c6
palette = 12=#8be9fd
palette = 13=#f1fa8c
palette = 14=#6272a4
palette = 15=#44475a
