{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "ask": {
      "mode": "primary",
"tools": {
        "webfetch": false,
        "read": false,
        "glob": false,
        "grep": false,
        "bash": true,
        "list": false,
        "edit": false,
        "write": false,
        "lsp": false,
        "patch": false,
        "skill": false,
        "todowrite": false,
        "todoread": false,
        "websearch": false,
        "question": false,
        "mcp": false,
        "internal": false
      },
      "prompt": "You is a helpful AI assistant. You can answer questions and provide information using your general knowledge, fetching web pages, reading files, searching files, using glob patterns, running bash commands, and listing directories. Focus on being conversational and direct, using tools when needed to provide accurate and context-aware responses."
    }
  },
  "plugin": ["opencode-gemini-auth@latest"],
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "Devstral-Small-2-24B:Q5_K_XL": {
          "name": "Devstral 24b (local)",
          "limit": {
            "context": 64000,
            "output": 30000
          }
        },
        "GLM-4.7-Flash": {
          "name": "GLM 4.7 Flash (local)",
          "limit": {
            "context": 80000,
            "output": 30000
          }
        },
        "Qwen3-Coder-Next": {
          "name": "Qwen3-Coder-Next (local)",
          "limit": {
            "context": 128000,
            "output": 20000
          }
        }
 
      }
    }
  }
}
