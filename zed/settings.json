// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_family": ".ZedSans",
  "icon_theme": "Soft Charmed Icons",
  "terminal": {
    "font_size": 15.0,
    "font_family": "AporeticSansMonoNerdFont"
  },
  "diff_view_style": "unified",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "open_ai_compatible_api"
  },
  "project_panel": {
    "dock": "left",
    "default_width": 300,
    "hide_root": true,
    "auto_fold_dirs": false,
    "sticky_scroll": false
  },
  "outline_panel": {
    "dock": "right",
    "default_width": 300
  },
  "file_finder": {
    "modal_max_width": "medium"
  },

  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false
  },
  "collaboration_panel": {
    "button": false,
    "dock": null
  },
  "git_panel": {
    "dock": "left"
  },
  //"buffer_font_weight": 500.0,
  //"ui_font_family": "IBM Plex Sans",
  "buffer_line_height": {
    "custom": 1.3
  },
  "agent": {
    "sidebar_side": "right",
    "favorite_models": [
    ],
    "dock": "right",
    "flexible": false,
    "default_width": 600,
    "default_profile": "write",
    "profiles": {
      "plan": {
        "name": "Plan",
        "tools": {
          "move_path": false,
          "copy_path": true,
          "create_directory": false,
          "diagnostics": true,
          "fetch": true,
          "find_path": true,
          "grep": true,
          "list_directory": true,
          "now": true,
          "terminal": true,
          "thinking": true,
          "read_file": true,
          "open": true
        },
        "enable_all_context_servers": true,
        "context_servers": {}
      },
      "all": {
        "default_model": {
          "provider": "openai",
          "model": "qwen3.8-27b",
          "effort": "xhigh",
          "enable_thinking": true
        },
        "name": "All",
        "tools": {
          "copy_path": false
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "default_model": {
      "enable_thinking": false,
      "provider": "llama.cpp",
      "model": "Qwen3.8-27B"
    },
    "model_parameters": []
  },
  "vim_mode": true,
  "base_keymap": "VSCode",

  "multi_cursor_modifier": "cmd_or_ctrl",
  "cursor_blink": false,
  //"buffer_font_family": "FiraCode Nerd Font Mono",
  //"buffer_font_family": ".ZedMono",
  //"buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "buffer_font_family": "AporeticSansMonoNerdFont",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_sign_in": false
    //"show_user_menu": false
  },
  "toolbar": {
    "quick_actions": false
  },
  "ui_font_size": 17.0,
  "agent_ui_font_size": 16.0,
  "buffer_font_size": 15.0,
  "agent_buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Dracula Flat"
  },
  "languages": {
    "Python": {
      "language_servers": [
        // Disable basedpyright and enable ty, and otherwise
        // use the default configuration.
        "ty",
        "ruff",
        "!basedpyright",
        "!pyright"
      ],
      "preferred_line_length": 100,
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true
      }
    }
  },
  "language_models": {
    "openai": {
      "api_url": "http://localhost:8080/v1",
      //"available_models": [
      //  {
      //    "name": "qwen3.8-27b",
      //    "display_name": "qwen3.8-27b",
      //    "max_tokens": 180000
      //  }
      //]
    },
    "openai_compatible": {
      "available_models": {
        "api_url": "http://10.129.20.218:8000/v1",
        "available_models": [
          {
            "name": "deepseek-v4-flash",
            "display_name": "deepseek-v4-flash",
            "max_tokens": 524288
          }
        ]
      }
    }
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          // Ruff server settings go here
          "lineLength": 100,
          "lint": {
            "extendSelect": ["I"]
          }
        }
      }
    },
    "ty": {
      "binary": {
        "path": "/home/linuxbrew/.linuxbrew/bin/ty",
        "arguments": ["server"]
      }
    }
  },
 "seed_search_query_from_cursor": "never",
 "show_whitespaces": "none"
} 
